{
  "name": "linkedin-lead-extractor",
  "version": "1.0.0",
  "description": "LinkedIn Lead Extractor with Apollo data capture",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "keywords": [],
  "author": "Your Name or Company",
  "license": "ISC",
  "dependencies": {
    "csv-stringify": "^6.5.2",
    
    "electron-store": "^10.0.1",
    "fs-extra": "^11.3.0",
    "os": "^0.1.2",
    "path": "^0.12.7",
    "puppeteer": "^24.8.2",
    "puppeteer-extra": "^3.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "electron": "^36.2.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.yourcompany.linkedinextractor",
    "productName": "LinkedIn Lead Extractor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!dist/",
      "!node_modules/*/{test,__tests__,tests}/",
      "src/"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
